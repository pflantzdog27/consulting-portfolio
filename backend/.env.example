# Server Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8000

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: Use Claude Projects for enhanced context (recommended: claude-3-5-sonnet-20241022)
CLAUDE_MODEL=claude-3-haiku-20240307
# Optional: Add your Claude Project ID to use project knowledge base
# Get this from your project URL: https://claude.ai/projects/YOUR_PROJECT_ID
CLAUDE_PROJECT_ID=

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/consultancy_db
REDIS_URL=redis://localhost:6379

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment_url
PINECONE_INDEX_NAME=consultant-website

# OpenAI (for embeddings)
OPENAI_API_KEY=your_openai_api_key

# Google Calendar Integration
GOOGLE_CALENDAR_ID=your_calendar_id@gmail.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_google_service_account_private_key\n-----END PRIVATE KEY-----"
GOOGLE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GOOGLE_PROJECT_ID=your_google_project_id

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=adam@pflantzer.com

# Security
JWT_SECRET=your_super_secret_jwt_key_here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Business Configuration
BUSINESS_NAME="Pflantzer Consulting"
BUSINESS_EMAIL="adam@pflantzer.com"
BUSINESS_PHONE="+1-646-730-2118"
BUSINESS_TIMEZONE="America/New_York"

# Meeting Types and Durations (in minutes)
DISCOVERY_CALL_DURATION=30
TECHNICAL_DEEP_DIVE_DURATION=60
STRATEGY_SESSION_DURATION=45

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log