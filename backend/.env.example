# Server Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8000

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/consultancy_db
REDIS_URL=redis://localhost:6379

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=servicenow-consultancy

# OpenAI (for embeddings)
OPENAI_API_KEY=your_openai_api_key

# Google Calendar Integration
GOOGLE_CALENDAR_ID=your_calendar@gmail.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PROJECT_ID=your-google-project-id

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=hello@devstudio.com

# Security
JWT_SECRET=your_super_secret_jwt_key_here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Business Configuration
BUSINESS_NAME="DevStudio"
BUSINESS_EMAIL="hello@devstudio.com"
BUSINESS_PHONE="+1-555-123-4567"
BUSINESS_TIMEZONE="America/New_York"

# Meeting Types and Durations (in minutes)
DISCOVERY_CALL_DURATION=30
TECHNICAL_DEEP_DIVE_DURATION=60
STRATEGY_SESSION_DURATION=45

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log